{
  "name": "pulse-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "PULSE — Real-Time Hyper-Local Discovery Platform",
  "scripts": {
    "dev": "pnpm --parallel --filter @pulse/web --filter @pulse/api dev",
    "dev:web": "pnpm --filter @pulse/web dev",
    "dev:api": "pnpm --filter @pulse/api dev",
    "build": "pnpm --filter \"@pulse/*\" build",
    "build:web": "pnpm --filter @pulse/web build",
    "build:api": "pnpm --filter @pulse/api build",
    "test": "pnpm --recursive test",
    "test:unit": "pnpm --filter @pulse/api test && pnpm --filter @pulse/web test",
    "lint": "pnpm --recursive lint",
    "typecheck": "pnpm --recursive typecheck",
    "clean": "pnpm --recursive exec rm -rf dist .next .open-next node_modules"
  },
  "devDependencies": {
    "@types/node": "^20.17.19",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}

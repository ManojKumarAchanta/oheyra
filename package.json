{
  "name": "oheyra-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Oheyra — Your city has plans. Real-Time Hyper-Local Discovery Platform",
  "scripts": {
    "dev": "pnpm --parallel --filter @oheyra/web --filter @oheyra/api dev",
    "dev:web": "pnpm --filter @oheyra/web dev",
    "dev:api": "pnpm --filter @oheyra/api dev",
    "build": "pnpm --filter \"@oheyra/*\" build",
    "build:web": "pnpm --filter @oheyra/web build",
    "build:api": "pnpm --filter @oheyra/api build",
    "test": "pnpm --recursive test",
    "test:unit": "pnpm --filter @oheyra/api test && pnpm --filter @oheyra/web test",
    "lint": "pnpm --recursive lint",
    "typecheck": "pnpm --recursive typecheck",
    "clean": "pnpm --recursive exec rm -rf dist .next .open-next node_modules"
  },
  "devDependencies": {
    "@types/node": "^20.17.19",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}

# ==============================================================
# OHEYRA MONOREPO — MASTER ENVIRONMENT SPECIFICATION
# ==============================================================
#
# INSTRUCTIONS:
# 1. Copy apps/web/.env.example to apps/web/.env.local for local frontend dev
# 2. Copy apps/api/.env.example to apps/api/.dev.vars for local Cloudflare Worker dev
# 3. For production:
#    - Frontend: Set Variables in Cloudflare Dashboard (Workers & Pages > oheyra-web > Settings > Variables)
#    - API: Set Variables in Cloudflare Dashboard (Workers & Pages > oheyra-api > Settings > Variables)
#    - Database: Apply migrations to Supabase via SQL Editor or Supabase CLI
#
# ==============================================================

# --- FRONTEND (apps/web on Cloudflare Workers) ---
NEXT_PUBLIC_SITE_URL=https://oheyra.city
NEXT_PUBLIC_API_URL=https://oheyra-api.yourname.workers.dev
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_MAP_STYLE_URL=https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json

# --- BACKEND (apps/api on Cloudflare Workers) ---
NODE_ENV=production
WEB_ORIGIN=https://oheyra.city
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-secret-service-role-key
SUPABASE_DB_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres

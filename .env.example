# ==============================================================
# PULSE MONOREPO — MASTER ENVIRONMENT SPECIFICATION
# ==============================================================
#
# INSTRUCTIONS:
# 1. Copy apps/web/.env.example to apps/web/.env.local for local frontend dev
# 2. Copy apps/api/.env.example to apps/api/.env for local backend dev
# 3. For production:
#    - Set Frontend variables in Cloudflare Dashboard (Workers & Pages > Settings > Variables)
#    - Set Backend variables in Koyeb Dashboard (App > Service > Environment Variables)
#    - Apply database migrations to Supabase via Supabase SQL Editor or Supabase CLI
#
# ==============================================================

# --- FRONTEND (apps/web) ---
NEXT_PUBLIC_SITE_URL=https://pulse.city
NEXT_PUBLIC_API_URL=https://pulse-api.koyeb.app
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_MAP_STYLE_URL=https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json

# --- BACKEND (apps/api) ---
NODE_ENV=production
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=info
WEB_ORIGIN=https://pulse.city
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-secret-service-role-key
SUPABASE_DB_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres

# ===============================================
# PULSE API (Fastify) Environment Configuration
# ===============================================

NODE_ENV=production
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=info

# Allowed Frontend Web Origin for CORS
WEB_ORIGIN=https://pulse.city

# Supabase Credentials (Server-side ONLY; NEVER leak to client)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-secret-service-role-key

# Direct PostgreSQL Connection URL (Used for Supabase CLI migrations)
SUPABASE_DB_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

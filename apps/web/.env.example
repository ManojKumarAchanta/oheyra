# ===============================================
# PULSE Web (Next.js) Environment Configuration
# ===============================================

# Canonical public site URL (Used for SEO, canonical tags, Open Graph)
NEXT_PUBLIC_SITE_URL=https://pulse.city

# Fastify Backend API URL (Points to Koyeb deployment in production)
NEXT_PUBLIC_API_URL=https://pulse-api.koyeb.app

# Supabase Public Keys (Safe for client-side exposure)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-public-anon-key

# Map Tile Provider URL (CARTO Dark Matter or OpenFreeMap)
# CARTO Dark Matter free endpoint (requires free API key from carto.com/basemaps/apikey/):
NEXT_PUBLIC_MAP_STYLE_URL=https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json
